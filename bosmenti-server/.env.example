# Nusxa oling:  cp .env.example .env   — so‘ng qiymatlarni to‘ldiring.
# .env faylini hech kimga yubormang va git'ga qo‘shmang.

# --- Serverga chiqarish (docker compose) ---
# Sayt domeni. Domenning DNS A yozuvi shu serverning IP manziliga qaratilgan bo‘lsin.
DOMAIN=bosmenti.uz
# Ma'lumotlar bazasi paroli: faqat lotin harflari va raqamlar, kamida 20 ta belgi.
DB_PASSWORD=

# --- Admin panelga kirish (/admin) ---
ADMIN_LOGIN=admin
# Kamida 12 belgi. Parolni almashtirish uchun shu yerda o‘zgartirib, serverni qayta ishga tushiring.
ADMIN_PASSWORD=

# --- Telegram (ixtiyoriy): har bir yangi buyurtma shu chatga xabar bo‘lib keladi ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# true: birinchi ishga tushganda 28 ta namunaviy mahsulot qo‘shiladi (keyin admin panelda tahrirlanadi).
# false: do‘kon bo‘sh ochiladi, mahsulotlarni o‘zingiz qo‘shasiz.
SEED_DEMO_PRODUCTS=true

# --- Faqat o‘z kompyuteringizda ishlatish uchun (npm run dev) ---
# DATABASE_URL=postgres://bosmenti:bosmenti@localhost:5432/bosmenti
# NODE_ENV=development
# PORT=3000
